<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <edu.hitsz.ui.BossHealthBarView
        android:id="@+id/bossHealthBar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topRightContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnMusic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="音乐开关"
            android:padding="12dp"
            android:src="@drawable/ic_volume_on"
            android:tint="#FFFFFF" />

        <edu.hitsz.ui.BuffCountdownView
            android:id="@+id/buffCountdownView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/skillContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnBomb"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:alpha="0.4"
            android:background="@drawable/bg_skill_circle"
            android:backgroundTint="#FFB300"
            android:contentDescription="炸弹技能"
            android:enabled="false"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skill_bomb"
            android:tint="#2A1A00" />

        <ImageButton
            android:id="@+id/btnHeal"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:alpha="0.4"
            android:background="@drawable/bg_skill_circle"
            android:backgroundTint="#4CD964"
            android:contentDescription="回血技能"
            android:enabled="false"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skill_heal"
            android:tint="#06280F" />

        <ImageButton
            android:id="@+id/btnRing"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:alpha="0.4"
            android:background="@drawable/bg_skill_circle"
            android:backgroundTint="#4DD0E1"
            android:contentDescription="环射技能"
            android:enabled="false"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skill_ring"
            android:tint="#00272B" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:elevation="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="32dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="GAME OVER"
                android:textColor="#FF6B6B"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="得分 0"
                android:textColor="#FFD54F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="再来一局"
                android:textAllCaps="false"
                android:textColor="#00363A"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#4DD0E1"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToMenu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="返回选择"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#263445"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
